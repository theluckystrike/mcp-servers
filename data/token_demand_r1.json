{
 "measured_at": "2026-09-10",
 "owner_agent": "A5",
 "namespace": "io.github.theluckystrike",
 "instrument": {
  "script": "scripts/token-demand.mjs",
  "endpoint": "https://registry.modelcontextprotocol.io/v0/servers?search=<token>&limit=100 (cursor paginated to exhaustion)",
  "ordering": "strict ASCII order on the FULL <namespace>/<local-name> string, case-sensitive; uppercase A-Z sorts before lowercase a-z",
  "matching": "substring of the NAME field only; the description is never searched",
  "pagination": "metadata.nextCursor = \"<name>:<version>\" of the last row on the page; metadata.count is the ROW COUNT of that page, not the corpus size",
  "why_full_pagination": "reading metadata.count off page one is an undercount and burned a prior round: pdf shows 100 on page one and holds 323 rows",
  "rank_formula": "landing_rank = 1 + (rows whose full name sorts strictly before the string \"io.github.theluckystrike/\"). The local name cannot change this: the namespace segment is compared first.",
  "visibility_model": "p = min(1, 10/rank) when rank <= 100, else 0 (the same model as data/registry_rank.json, so numbers here compare with earlier rounds)",
  "controls": {
   "positive": {
    "query": "theluckystrike",
    "rows": 1394,
    "expect": ">0",
    "pass": true
   },
   "negative": {
    "query": "offline",
    "rows": 3,
    "expect": "no io.github.theluckystrike row matched on description text",
    "pass": true
   },
   "instrument_trusted": true
  }
 },
 "demand_sources": [
  {
   "id": "registry_attempts",
   "what": "distinct MCP servers in the official registry whose NAME carries the token",
   "free": true,
   "note": "a crowded token is demand AND competition; both are reported (supply_servers, supply_namespaces)"
  },
  {
   "id": "github_qualified",
   "what": "gh api search/repositories total_count for the QUALIFIED phrase (\"packing list\", not \"packing\") in name,description, with and without the word mcp",
   "free": true,
   "note": "the bare single token is homonym-contaminated for most candidates; homonym_contamination_x is bare/qualified and reaches 767x on \"training\". The qualified count is what enters the score."
  },
  {
   "id": "spec_and_client_docs",
   "what": "grep of modelcontextprotocol/servers README.md and the draft spec index for each token",
   "free": true,
   "result": "ZERO real hits across all 70 candidates. The only matches were substrings inside other words (sla in translation, rma in format, lien in client). Positive control: \"filesystem\" returns 3 hits in the official server list, so the instrument works. This axis discriminates nothing and is therefore recorded as measured-and-empty rather than scored."
  }
 ],
 "scoring": {
  "score": "visibility_p * demand_score * (buildability / 2)",
  "demand_score": "0.6 * min(1, log10(1+gh_mcp_repos)/2) + 0.4 * min(1, log10(1+gh_all_repos)/5)",
  "buildability": "2 = pure local computation, no bundled reference data, fits the existing local-document estate; 1 = needs a bundled static table or the honest scope is thin; 0 = needs a network, a paid API or regulated data we cannot source",
  "unsourced_rule": "a candidate with 0 registry attempts AND fewer than 5 qualified MCP repos is marked demand_sourced:false and is NOT scored; it is listed and excluded",
  "excluded_rule": "a candidate already covered by an existing server is listed with covered_by_existing_server and not scored",
  "honest_limitation": "visibility_p barely discriminates among the winners, because min(1,10/rank) saturates at rank 10. That is the real finding, not a defect: once a token is winnable, rank stops being the lever and demand and buildability decide. visibility_p works as a HARD GATE, zeroing bom (109), sla (409) and rma (502), which no local name can reach."
 },
 "servers_already_shipped": 32,
 "candidates_probed": 70,
 "built_this_round": [
  {
   "server": "servers/packing-list",
   "token": "packing",
   "composite_rank": 14,
   "landing_rank": 3,
   "why": "the highest-ranked candidate inside the estate own order-to-invoice chain (work-order, delivery-schedule, catalogue, invoice), which is the buyer the other 32 servers already serve. Its composite rank is 14 because the qualified GitHub correction cut its demand count 8.5x, from 15288 to 1803; that correction is reported rather than hidden."
  },
  {
   "server": "servers/checklist",
   "token": "checklist",
   "composite_rank": 1,
   "landing_rank": 7,
   "why": "the top-scoring candidate of all 70, and a multi-token play: one codebase under three registry names is on page one for checklist (7), snag (2), handover (3) and onboarding (7)."
  }
 ],
