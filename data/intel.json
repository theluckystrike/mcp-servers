    "name": "expense_add",
    "description": "Log an expense: amount, currency, category, vendor, date, project, billable flag, optional receipt file path."
   },
   {
    "name": "expense_list",
    "description": "List expenses as a compact table with filters for date range, project, category and billable. Free tier shows the last 30 days."
   },
   {
    "name": "expense_update",
    "description": "Change any field on one expense by id."
   },
   {
    "name": "expense_delete",
    "description": "Delete one expense by id."
   },
   {
    "name": "receipt_attach",
    "description": "Attach a local receipt file to an expense; stores the path, size, sha256 and mime type. No upload, no OCR."
   },
   {
    "name": "category_rules",
    "description": "Define and list keyword-to-category rules so vendor strings auto-categorise on add."
   },
   {
    "name": "expense_summary",
    "description": "Totals by category, project, month and billable/non-billable, with a period comparison."
   },
   {
    "name": "mileage_add",
    "description": "Log a trip in km or miles at a per-unit rate and store it as an expense."
   },
   {
    "name": "expense_export",
    "description": "Export a filtered set to CSV or JSON for an accountant. Pro: XLSX via the spreadsheet writer."
   },
   {
    "name": "expense_to_invoice",
    "description": "Emit billable expenses for a project as invoice line items in the shape servers/invoice consumes (rebillable pass-through with an optional markup)."
   }
