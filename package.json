{
  "name": "mcp-servers-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "servers/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --test test/*.test.mjs",
    "pretest": "node scripts/pretest-dist.mjs",
    "build:dist": "node scripts/pretest-dist.mjs --build",
    "prebuild": "node scripts/bootstrap-timezone.mjs && node scripts/sync-versions.mjs && node scripts/build-matcher-demo.mjs",
    "release:check": "node scripts/release-check.mjs",
    "digest": "node scripts/digest.mjs",
    "build:matcher-demo": "node scripts/build-matcher-demo.mjs",
    "test:matcher-browser": "node scripts/matcher-browser-smoke.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "esbuild": "0.27.3",
    "marked": "^18.0.11"
  },
  "overrides": {
    "zod": "^3.25.76"
  }
}
