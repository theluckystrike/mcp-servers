{
  "name": "@theluckystrike/mcp-office-suite",
  "version": "0.12.0",
  "description": "One install for the whole freelancer office suite: time tracking, price watching, spreadsheets and PDF invoicing, proxied behind a single MCP server.",
  "type": "module",
  "bin": {
    "mcp-office-suite": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"import('node:fs').then(f=>f.chmodSync('dist/index.js',0o755))\"",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "bundle",
    "office",
    "time-tracking",
    "invoicing",
    "spreadsheet",
    "price-tracking",
    "freelance"
  ],
  "license": "MIT",
  "author": "theluckystrike",
  "repository": {
    "type": "git",
    "url": "https://github.com/theluckystrike/mcp-servers",
    "directory": "servers/office-suite"
  },
  "homepage": "https://github.com/theluckystrike/mcp-servers/tree/main/servers/office-suite",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@theluckystrike/mcp-time-tracker": "^0.12.0",
    "@theluckystrike/mcp-price-tracker": "^0.12.0",
    "@theluckystrike/mcp-spreadsheet": "^0.12.0",
    "@theluckystrike/mcp-invoice": "^0.12.0",
    "@theluckystrike/mcp-currency": "^0.12.0",
    "@theluckystrike/mcp-timezone": "^0.12.0",
    "@theluckystrike/mcp-docx": "^0.12.0",
    "@theluckystrike/mcp-resume": "^0.12.0",
    "@theluckystrike/mcp-recurring": "^0.12.0",
    "@theluckystrike/mcp-clauses": "^0.12.0",
    "@theluckystrike/mcp-pdf": "^0.12.0",
    "@theluckystrike/mcp-calendar": "^0.12.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
