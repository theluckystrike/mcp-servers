  },
  "homepage": "https://github.com/theluckystrike/mcp-servers/tree/main/servers/price-tracker",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@theluckystrike/mcp-license": "^0.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
