{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.theluckystrike/credit-note",
  "description": "Credit notes against an invoice or standalone: drafts, finalization, rendering, totals.",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/theluckystrike/mcp-servers",
    "source": "github",
    "subfolder": "servers/credit-note"
  },
  "websiteUrl": "https://mcp.zovo.one/s/credit-note",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@theluckystrike/mcp-credit-note",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "MCP_LICENSE_KEY",
          "description": "Optional Pro license key (MCPL1....). Verified offline.",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
